FROM node:18 AS build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx-prod.conf /etc/nginx/conf.d/default.conf
# IP 차단 안내 페이지 — SPA 산출물과 섞이지 않도록 별도 root 에 둔다.
# nginx-prod.conf 의 location @blocked 가 이 경로를 참조한다.
COPY ip-blocked.html /usr/share/nginx/errors/ip-blocked.html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]